{
	"manifest_version": 3,
	"name": "Tolaria Clipper",
	"homepage_url": "https://tolaria.md/",
	"version": "1.7.1",
	"description": "Save and highlight web pages straight into your Tolaria vault, in a private and durable format you can access offline.",
	"permissions": [
		"activeTab",
		"clipboardWrite",
		"contextMenus",
		"nativeMessaging",
		"storage",
		"scripting"
	],
	"host_permissions": [
		"<all_urls>",
		"http://*/*",
		"https://*/*"
	],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"options_ui": {
		"page": "settings.html"
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": ["http://*/*", "https://*/*"],
			"js": ["browser-polyfill.min.js", "content.js"]
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["reader.css", "reader-script.js", "browser-polyfill.min.js", "style.css", "side-panel.html", "flatten-shadow-dom.js", "highlighter.css"],
			"extension_ids": ["*"],
			"matches": [ "*://*/*" ]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+Y",
				"mac": "Command+Shift+Y"
			},
			"description": "Open Tolaria Clipper"
		},
		"quick_clip": {
			"suggested_key": {
				"default": "Alt+Shift+Y",
				"mac": "Alt+Shift+Y"
			},
			"description": "Quick clip"
		},
		"toggle_highlighter": {
			"suggested_key": {
				"default": "Alt+Shift+J",
				"mac": "Alt+Shift+J"
			},
			"description": "Toggle highlighter mode"
		},
		"toggle_reader": {
			"suggested_key": {
				"default": "Alt+Shift+K",
				"mac": "Alt+Shift+K"
			},
			"description": "Toggle reading view"
		}
	}
}
